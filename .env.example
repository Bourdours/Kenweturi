#--------------------------------------------------------------------
# Example Environment Configuration file
#
# Copie ce fichier en .env et remplis les valeurs :
#   cp .env.example .env
#
# Le fichier .env ne doit JAMAIS être commité sur Git.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'http://localhost:8080/'

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = kenweturi
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.port     = 3306

#--------------------------------------------------------------------
# MAILER (PHPMailer)
# Obtiens tes identifiants SMTP auprès de ton fournisseur email.
# Exemple avec Gmail : https://support.google.com/mail/answer/185833
#--------------------------------------------------------------------

mailer.host     = smtp.ton-fournisseur.com
mailer.port     = 587
mailer.username = ton-email@example.com
mailer.password = ton-mot-de-passe-smtp
mailer.from     = noreply@example.com
mailer.fromName = Kenweturi

#--------------------------------------------------------------------
# SITE (informations publiques affichées dans les pages légales)
#--------------------------------------------------------------------

site.contactEmail = contact@example.com
site.siteUrl      = kenweturi.fr

